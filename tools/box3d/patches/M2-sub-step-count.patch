From f9784a29312c13caa4229f4ded8656ec96c17e81 Mon Sep 17 00:00:00 2001
From: General Beria <general-beria@tripofobia.local>
Date: Tue, 1 Sep 2026 15:24:24 -0600
Subject: [PATCH] M2: SUB_STEP_COUNT configurable via project setting (was
 hardcoded 4)

---
 src/misc/box3d_globals.cpp    | 23 +++++++++++++++++++++++
 src/misc/box3d_globals.hpp    |  4 ++++
 src/spaces/box3d_space_3d.cpp |  8 ++------
 3 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/src/misc/box3d_globals.cpp b/src/misc/box3d_globals.cpp
index be5183d..b7c1577 100644
--- a/src/misc/box3d_globals.cpp
+++ b/src/misc/box3d_globals.cpp
@@ -13,6 +13,8 @@ using namespace godot;
 
 namespace {
 const char *WORKER_COUNT_SETTING = "physics/box3d/worker_count";
+const char *SUB_STEP_COUNT_SETTING = "physics/box3d/sub_step_count";
+constexpr int DEFAULT_SUB_STEP_COUNT = 1; // Tripofobia patch M2: was hardcoded 4
 } // namespace
 
 void box3d_initialize() {
@@ -29,6 +31,18 @@ void box3d_initialize() {
 	info["hint"] = PROPERTY_HINT_RANGE;
 	info["hint_string"] = "0,32,1";
 	settings->add_property_info(info);
+
+	if (!settings->has_setting(SUB_STEP_COUNT_SETTING)) {
+		settings->set_setting(SUB_STEP_COUNT_SETTING, 0);
+	}
+	settings->set_initial_value(SUB_STEP_COUNT_SETTING, 0);
+	settings->set_restart_if_changed(SUB_STEP_COUNT_SETTING, true);
+	Dictionary sub_info;
+	sub_info["name"] = SUB_STEP_COUNT_SETTING;
+	sub_info["type"] = Variant::INT;
+	sub_info["hint"] = PROPERTY_HINT_RANGE;
+	sub_info["hint_string"] = "0,8,1";
+	settings->add_property_info(sub_info);
 }
 
 void box3d_deinitialize() {
@@ -43,3 +57,12 @@ int box3d_worker_count() {
 	}();
 	return count;
 }
+
+int box3d_sub_step_count() {
+	static const int count = []() {
+		const int setting = (int)ProjectSettings::get_singleton()->get_setting_with_override(
+				SUB_STEP_COUNT_SETTING);
+		return setting > 0 ? std::clamp(setting, 1, 8) : DEFAULT_SUB_STEP_COUNT;
+	}();
+	return count;
+}
diff --git a/src/misc/box3d_globals.hpp b/src/misc/box3d_globals.hpp
index 0a0c55b..4481da0 100644
--- a/src/misc/box3d_globals.hpp
+++ b/src/misc/box3d_globals.hpp
@@ -8,3 +8,7 @@ void box3d_deinitialize();
 
 // The physics/box3d/worker_count setting, or the detected core count when it is 0 (auto).
 int box3d_worker_count();
+
+// The physics/box3d/sub_step_count setting, or 1 (the new safe default) when it is 0 (auto).
+// Tripofobia patch M2: was hardcoded to 4, which caused 240 sub-steps/sec with 60 Hz physics.
+int box3d_sub_step_count();
diff --git a/src/spaces/box3d_space_3d.cpp b/src/spaces/box3d_space_3d.cpp
index b12f1eb..4918a64 100644
--- a/src/spaces/box3d_space_3d.cpp
+++ b/src/spaces/box3d_space_3d.cpp
@@ -11,10 +11,6 @@
 
 #include <box3d/box3d.h>
 
-namespace {
-constexpr int SUB_STEP_COUNT = 4;
-} // namespace
-
 Box3DSpace3D::Box3DSpace3D() {
 	b3WorldDef def = b3DefaultWorldDef();
 	// With no task callbacks set, any count above 1 engages Box3D's internal scheduler.
@@ -53,7 +49,7 @@ double Box3DSpace3D::get_param(PhysicsServer3D::SpaceParameter p_param) const {
 		case PhysicsServer3D::SPACE_PARAM_BODY_TIME_TO_SLEEP:
 			return 0.5;
 		case PhysicsServer3D::SPACE_PARAM_SOLVER_ITERATIONS:
-			return SUB_STEP_COUNT;
+			return box3d_sub_step_count();
 		default:
 			return 0.0;
 	}
@@ -87,7 +83,7 @@ void Box3DSpace3D::step(float p_step) {
 		body->pre_step();
 	}
 
-	b3World_Step(world_id, p_step, SUB_STEP_COUNT);
+	b3World_Step(world_id, p_step, box3d_sub_step_count());
 
 	_pull_body_events();
 	_pull_sensor_events();
-- 
2.40.0.windows.1


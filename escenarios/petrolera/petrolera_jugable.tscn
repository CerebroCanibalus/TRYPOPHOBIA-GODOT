[gd_scene load_steps=2 format=3]

; La Petrolera lista para correr.
;
; petrolera.tscn ya trae dentro su cielo, su sol y a Iza: lo escribe entero
; montar_petrolera.py y una mision tiene que poder abrirse sola. Asi que esta
; escena NO instancia otro jugador — hacerlo ponia dos camaras y dos
; CharacterBody3D leyendo el mismo teclado, y lo que se veia no era el mapa mal
; montado sino la camara equivocada. Aqui solo se le cuelga lo que el generador no
; puede escribir: la linterna y las marcas de salida.
;
; LA LINTERNA VA AQUI Y NO EN IzaPlayer.tscn: el jugador no monta ninguna luz, y
; de los trece metros de agua para abajo eso es injugable. Se pone en la escena y
; no en el prefab compartido para no tocar al jugador de los demas mientras esto
; se decide. src/player/flashlight.tscn existe, pero su script pide un
; $AnimationTree que esa escena no tiene, asi que va un SpotLight3D pelado con sus
; mismos valores (alcance 21,33 · cono 15,28).

[ext_resource type="PackedScene" path="res://escenarios/petrolera/petrolera.tscn" id="1_mapa"]

[node name="PetroleraJugable" type="Node3D"]

[node name="Petrolera" parent="." instance=ExtResource("1_mapa")]

[node name="Linterna" type="SpotLight3D" parent="Petrolera/Iza/CameraPivot/Camera3D"]
shadow_enabled = true
spot_range = 21.3291
spot_angle = 15.2845

; Para empezar en otro sitio, arrastrar a Petrolera/Iza a una de estas. Van
; DESPLAZADAS DEL EJE del nudo a proposito: en el eje esta la columna, que mide 5 m
; de diametro, y alli no hay suelo — el de la rotonda es un anillo alrededor de la
; pata. Puesta en el centro, Iza cae al fondo del mar. La rotonda
; de la plataforma esta en el origen con 16,70 de radio y su suelo en -12; las de
; los extremos, en los pies de I0 e I6. (Blender -> Godot: x, z, -y.)

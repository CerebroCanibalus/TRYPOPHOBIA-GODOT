# Godot specific ignores
.godot/
# Cache del editor: se regenera sola y es distinta en cada maquina. Estaba
# versionada con 3887 ficheros y 67 MB, y era la causa de que cada sesion
# de Godot dejara 150 ficheros 'modificados' en el arbol.
# *.import NO se ignora: es la convencion de Godot y ademas guarda los
# ajustes de importacion. Para el pixel art de este juego eso es el asset:
# sin el .import, Godot reimporta con compresion VRAM y mipmaps, y la
# cuantizacion a Tripofobia-32 deja de ser exacta. Ya habia 1074 versionados
# de antes de esta regla; la regla solo bloqueaba los NUEVOS.
*.uid
.rid
.scene
.tscn
.gd
*.gdc
*.gde
# NOTA: `*.gd` y `*.res` estaban listados aca y ocultaban TODO script o recurso
# nuevo que se creara: los scripts y los .res del ragdoll nunca llegaron a git.
# El codigo fuente SI se versiona.
*.tres
# EXCEPCION: los materiales compartidos SI se versionan (regla de oro: los
# materiales/shaders viven como .tres o como sub-recursos del .tscn, nunca
# creados proceduralmente en GDScript).
!src/**/materials/*.tres
export_presets.cfg
GodotSharp/
mono_crash.*
user://

# Dependencies
node_modules/
vendor/


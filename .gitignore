# Godot specific ignores
.godot/
# Cache del editor: se regenera sola y es distinta en cada maquina. Estaba
# versionada con 3887 ficheros y 67 MB, y era la causa de que cada sesion
# de Godot dejara 150 ficheros 'modificados' en el arbol.
# *.import NO se ignora: es la convencion de Godot y ademas guarda los
# ajustes de importacion. Para el pixel art de este juego eso es el asset:
# sin el .import, Godot reimporta con compresion VRAM y mipmaps, y la
# cuantizacion a Tripofobia-32 deja de ser exacta. Ya habia 1074 versionados
# de antes de esta regla; la regla solo bloqueaba los NUEVOS.

!src/**/materials/*.tres
export_presets.cfg
GodotSharp/
mono_crash.*
user://

# Dependencies
node_modules/
vendor/

# Build artifacts
build/
dist/
bin/
*.exe
*.dll
*.so
*.dylib

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.orig

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Cache
.cache/
*.cache

# AI / Agents
# OJO: AGENTS.md NO se ignora — es la memoria viva del proyecto y SI se
# versiona. Lo que se ignora aqui es el estado local de las herramientas.
.opencode/
.hammerforge/

# Box3D development (FASE 2 — plugin recompilation)
# Source clone IS committed (snapshot for PR reproducibility)
# But build artifacts and internal .git are excluded
tools/box3d/build/
tools/box3d/godot-box3d-src/.git/
tools/box3d/godot-box3d-src/bin/

tools/active_ragdoll_reference/

# Heren MCP: estado de RUNTIME (cambia en cada arranque del editor; no es codigo)
.heren/

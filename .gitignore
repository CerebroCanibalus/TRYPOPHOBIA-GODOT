.env
.env.local
*.env.*

# OS
.DS_Store
Thumbs.db

# Cache
.cache/
*.cache

# AI / Agents
AGENTS.md

# Box3D development (FASE 2 — plugin recompilation)
# Source clone IS committed (snapshot for PR reproducibility)
# But build artifacts and internal .git are excluded
tools/box3d/build/
tools/box3d/godot-box3d-src/.git/
tools/box3d/godot-box3d-src/bin/

tools/active_ragdoll_reference/

# Heren MCP: estado de RUNTIME (cambia en cada arranque del editor; no es codigo)
.heren/backup/
.heren/tmp/
.heren/server_port.json
.heren/session.json
